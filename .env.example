# Copy to .env and fill in. NEVER commit .env.
# Values below are for LOCAL DEVELOPMENT ONLY.

# --- App ---
APP_ENV=development
# testnet | mainnet — mainnet must be explicit
NETWORK_MODE=testnet
LOG_LEVEL=info
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000

# --- Local infra (docker-compose) ---
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only
APP_DB_PASSWORD=da_dev_only
VAULT_DB_PASSWORD=vault_dev_only

# Docker: port = POSTGRES_HOST_PORT (default 5432). Native install: use its port instead
# (see scripts/db/native-setup.sql). Tests use <db>_test on the same server unless set below.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://da:da_dev_only@127.0.0.1:5432/digital_archaeology
TEST_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# --- Blockchain (Phase 5) ---
# RPC URL per network; the network row stores only this variable NAME (networks.rpc_url_env).
SEPOLIA_RPC_URL=
# Etherscan API v2 key (https://etherscan.io/apidashboard) — works for Sepolia too.
EXPLORER_API_KEY=
EXPLORER_API_URL=https://api.etherscan.io/v2/api
EXPLORER_RATE_LIMIT_PER_SECOND=4

# --- Valuation & scheduler (Phase 6) ---
# USD | IDR. Testnet assets are valued with their mainnet price and always labelled SIMULATED.
FIAT_CURRENCY=USD
PRICE_API_URL=https://api.coingecko.com/api/v3
# Optional CoinGecko demo/pro key (works without one, at a lower rate limit).
PRICE_API_KEY=
PRICE_UPDATE_INTERVAL_MINUTES=60
# Automatic scan of every active network (5-field cron, or "off"). Default: daily at 02:00.
SCAN_SCHEDULE_CRON=0 2 * * *
SCHEDULER_TIMEZONE=Asia/Jakarta

# --- Business rules ---
INACTIVITY_THRESHOLD_DAYS=730
FEE_MARGIN_PERCENT=20
CHALLENGE_TTL_MINUTES=15
CONFIRMATIONS_REQUIRED=3

# --- Auth (Phase 3) ---
APP_ORIGIN=http://127.0.0.1:5173
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
# true in production (HTTPS). Empty = true only when APP_ENV=production.
COOKIE_SECURE=
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
# Password for the development users created by `pnpm --filter backend db:seed` (APP_ENV=development only)
SEED_DEV_PASSWORD=

# --- Authorization documents (Phase 7) ---
DOCUMENT_ENCRYPTION_KEY=

# --- Recovery eligibility (Phase 8b) ---
# Minimum value (in FIAT_CURRENCY) that must arrive after fees; otherwise NOT_ECONOMIC.
RECOVERY_MIN_NET_VALUE=10
# Safety margin on the EIP-1559 fee estimate, percent.
FEE_MARGIN_PERCENT=20
# Balances older than this (hours) are treated as stale.
ELIGIBILITY_BALANCE_MAX_AGE_HOURS=36

# --- Transactions (Phase 9) ---
# How long a REVIEWER approval stays valid before a new preview is needed.
APPROVAL_TTL_MINUTES=30
# Phase 11: confirmations before CONFIRMED, check interval, and when to flag a tx as STUCK.
TX_CONFIRMATIONS=3
TX_CHECK_INTERVAL_SECONDS=30
TX_STUCK_MINUTES=30

# --- Security alerts (Phase 13b) ---
# Telegram bot (via @BotFather) + the chat/group that receives alerts. Both or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Prometheus scrape token for GET /metrics (>= 32 chars). Empty = /metrics disabled.
METRICS_TOKEN=

# --- Signer service (Phase 7) ---
# Backend → signer. The signer listens on loopback only (SIGNER_ALLOW_NON_LOOPBACK=true to override).
# Plain http only to a loopback host (passphrases travel in these requests); otherwise https.
SIGNER_URL=http://127.0.0.1:4000
# Explicit opt-out for a private container network until TLS exists (logged as a warning).
SIGNER_ALLOW_INSECURE_HTTP=false
SIGNER_HOST=127.0.0.1
SIGNER_PORT=4000
# Shared by backend and signer, >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SIGNER_HMAC_SECRET=
# Only read by signer/ — in production give these ONLY to the signer, never to the backend:
VAULT_DATABASE_URL=postgresql://da_vault:vault_dev_only@127.0.0.1:5432/da_vault
VAULT_UNLOCK_TTL_MINUTES=10
# Signer-only: read-only login to the APPLICATION DB, used to verify approvals before signing
# transactions (ADR-023). Role created by docker/postgres/init/02-signer-readonly.sh.
APP_DATABASE_URL_READONLY=postgresql://da_signer_ro:signer_ro_dev_only@127.0.0.1:5432/digital_archaeology
KEY_REVEAL_ENABLED=true
# There is intentionally NO variable for the vault passphrase.
