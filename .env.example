# Copy to .env and fill in. NEVER commit .env.
# Values below are for LOCAL DEVELOPMENT ONLY.

# --- App ---
APP_ENV=development
# testnet | mainnet — mainnet must be explicit
NETWORK_MODE=testnet
LOG_LEVEL=info
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000

# --- Local infra (docker-compose) ---
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only
APP_DB_PASSWORD=da_dev_only
VAULT_DB_PASSWORD=vault_dev_only

# Docker: port = POSTGRES_HOST_PORT (default 5432). Native install: use its port instead
# (see scripts/db/native-setup.sql). Tests use <db>_test on the same server unless set below.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://da:da_dev_only@127.0.0.1:5432/digital_archaeology
TEST_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# --- Blockchain (Phase 5) ---
SEPOLIA_RPC_URL=
EXPLORER_API_KEY=

# --- Pricing (Phase 6) ---
PRICE_PROVIDER=coingecko
PRICE_API_KEY=
FIAT_CURRENCY=USD

# --- Business rules ---
INACTIVITY_THRESHOLD_DAYS=730
FEE_MARGIN_PERCENT=20
CHALLENGE_TTL_MINUTES=15
CONFIRMATIONS_REQUIRED=3

# --- Auth (Phase 3) ---
APP_ORIGIN=http://127.0.0.1:5173
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
# true in production (HTTPS). Empty = true only when APP_ENV=production.
COOKIE_SECURE=
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
# Password for the development users created by `pnpm --filter backend db:seed` (APP_ENV=development only)
SEED_DEV_PASSWORD=

# --- Authorization documents (Phase 7) ---
DOCUMENT_ENCRYPTION_KEY=

# --- Signer service (Phase 7) ---
SIGNER_URL=http://127.0.0.1:4000
SIGNER_HMAC_SECRET=
# Only read by signer/:
VAULT_DATABASE_URL=postgresql://da_vault:vault_dev_only@127.0.0.1:5432/da_vault
VAULT_UNLOCK_TTL_MINUTES=10
KEY_REVEAL_ENABLED=true
# There is intentionally NO variable for the vault passphrase.
