# Backend (API + workers). APP_ENV, hosts/ports, SIGNER_URL and TRUST_PROXY are set in compose.prod.yml.
# The backend refuses to start in production when a setting is insecure (CONFIG_INSECURE).
LOG_LEVEL=info
NETWORK_MODE=testnet
# Mainnet only after the Sepolia E2E and a restore drill (runbook §14). Then: NETWORK_MODE=mainnet
# plus the mainnet RPC; the first transfer to every destination is capped (ADR-028):
MAINNET_FIRST_TRANSFER_MAX_VALUE=25

DATABASE_URL=postgresql://da:<APP_DB_PASSWORD>@postgres:5432/digital_archaeology
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379

APP_ORIGIN=https://archaeology.example.com
COOKIE_SECURE=true
# 32 random bytes, base64: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# Same value as in signer.env. openssl rand -hex 32
SIGNER_HMAC_SECRET=

SEPOLIA_RPC_URL=
EXPLORER_API_KEY=
PRICE_API_KEY=
FIAT_CURRENCY=USD

# Monitoring (optional). openssl rand -hex 32
METRICS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
