# Signer (Key Vault). Never give it DATABASE_URL, MFA_ENCRYPTION_KEY or REDIS_URL.
LOG_LEVEL=info
VAULT_DATABASE_URL=postgresql://da_vault:<VAULT_DB_PASSWORD>@postgres:5432/da_vault
# Read-only login used to verify approvals itself (ADR-023).
APP_DATABASE_URL_READONLY=postgresql://da_signer_ro:<SIGNER_RO_DB_PASSWORD>@postgres:5432/digital_archaeology
# Same value as in backend.env.
SIGNER_HMAC_SECRET=
VAULT_UNLOCK_TTL_MINUTES=10
KEY_REVEAL_ENABLED=true
